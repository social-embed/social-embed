// Biome is retained for ONE job: formatting the `---` frontmatter of `.astro`
// files, which oxfmt does not support. JS/TS/JSX/TSX/JSON/CSS formatting and all
// linting live in oxfmt + oxlint (see .oxfmtrc.json, .oxlintrc.json).
//
// Invariants:
//  1. `files.includes` stays scoped to `**/*.astro` (plus trunk's ignore globs),
//     or biome and oxfmt reformat each other's output.
//  2. Formatter options match `.oxfmtrc.json` (80 columns, double quotes,
//     semicolons are biome's defaults; only `indentStyle` differs).
//  3. `$schema` matches the pinned @biomejs/biome version.
//  4. Biome always formats this file; `.oxfmtrc.json` ignores it.
{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "assist": { "enabled": false },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.astro",
      "!**/node_modules",
      "!**/dist",
      "!**/static",
      "!**/public",
      "!**/.astro",
      "!**/build",
      "!**/playwright-report",
      "!**/docs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": { "enabled": false }
}
