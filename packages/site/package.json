{
  "name": "@social-embed/site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "type-check": "astro sync && tsc --noEmit -p tsconfig.typecheck.json && echo '[site] NOTE: .astro templates unchecked under TS7 - astro check returns at TS 7.1 (pnpm type-check:astro)'",
    "type-check:astro": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "ncu": "ncu",
    "update": "ncu",
    "lint": "biome lint .",
    "biome": "biome",
    "format": "pnpm run biome check . --write; pnpm run biome format . --write"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.7",
    "@astrojs/mdx": "^7.0.6",
    "@astrojs/react": "^6.0.3",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@pagefind/default-ui": "^1.5.2",
    "@social-embed/lib": "workspace:*",
    "@social-embed/wc": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.9",
    "@types/hast": "^3.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro-expressive-code": "^0.44.1",
    "es-module-lexer": "^2.3.2",
    "github-slugger": "^2.0.0",
    "glob": "^13.0.6",
    "happy-dom": "^20.11.2",
    "magic-string": "^1.2.1",
    "pagefind": "^1.5.2",
    "satteri": "^0.10.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
