{
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @social-embed/lib build && pnpm --filter @social-embed/wc build",
    "clean": "pnpm run --recursive clean",
    "format": "oxfmt && biome format --write .",
    "format:check": "oxfmt --check && biome format .",
    "lint": "oxlint",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:fix": "oxlint --fix",
    "lint:type-aware": "oxlint -c .oxlintrc.typeaware.json --type-aware",
    "check": "pnpm run --recursive check",
    "type-check": "pnpm run --recursive type-check",
    "type-check:tsc": "pnpm run --recursive type-check:tsc",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "build:watch": "pnpm run --recursive build:watch",
    "test": "pnpm run --recursive test",
    "test:watch": "pnpm run --recursive test:watch",
    "ncu": "pnpm run ncu-local -u; pnpm run --recursive ncu",
    "ncu-local": "ncu",
    "update": "pnpm run --recursive update",
    "update:all": "ncu -u && pnpm --recursive exec ncu -u",
    "reinstall": "rm -rf node_modules packages/*/node_modules && pnpm i",
    "serve": "pnpm run --recursive serve"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "packageManager": "pnpm@12.17.0",
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "knip": "^6.44.1",
    "oxfmt": "0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-config-tailwindcss": "^1.0.1"
  }
}
