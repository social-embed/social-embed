{
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "bun run --filter @social-embed/lib --elide-lines=0 build && bun run --filter @social-embed/wc --elide-lines=0 build",
    "clean": "bun run --filter '*' --elide-lines=0 clean",
    "distclean": "bun run --filter '*' --elide-lines=0 distclean",
    "format": "bun run --filter '*' --elide-lines=0 format",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "bun run --filter '*' --elide-lines=0 check",
    "type-check": "bun run --filter '*' --elide-lines=0 type-check",
    "type-check:tsc": "bun run --filter '*' --elide-lines=0 type-check:tsc",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "build:watch": "bun run --filter '*' --elide-lines=0 build:watch",
    "test": "bun run --filter '*' --elide-lines=0 test",
    "test:watch": "bun run --filter '*' --elide-lines=0 test:watch",
    "ncu": "bun run ncu-local -u; bun run --filter '*' --elide-lines=0 ncu",
    "ncu-local": "ncu",
    "update": "bun run --filter '*' --elide-lines=0 update",
    "update:all": "ncu -u && bun run --filter '*' --elide-lines=0 ncu -u",
    "reinstall": "rm -rf node_modules packages/*/node_modules && bun install",
    "docs": "bun run --filter '*' --elide-lines=0 docs",
    "docs:gen:watch": "bun run --filter '*' --elide-lines=0 docs:gen:watch",
    "docs:serve": "bun run --filter '*' --elide-lines=0 docs:serve",
    "serve": "bun run --filter '*' --elide-lines=0 serve"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "knip": "^6.29.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@codemirror/view": "^6.43.0"
  }
}
